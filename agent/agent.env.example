# AI participant configuration. Copy to agent.env and fill in.

# Server and the agent's own token: in the admin console, add a user with
# kind "AI agent", then invite it to documents like any person.
COLLAB_SERVER_URL=http://127.0.0.1:14008
COLLAB_AGENT_TOKEN=

# anthropic (Claude) or openai (OpenAI or any compatible server: Ollama,
# LM Studio, vLLM, llama.cpp). Example for Ollama: provider openai,
# base URL http://localhost:11434/v1 and a model that supports tool calling.
COLLAB_AGENT_PROVIDER=anthropic
COLLAB_AGENT_MODEL=claude-sonnet-5
COLLAB_AGENT_API_KEY=
# COLLAB_AGENT_BASE_URL=

# When to answer: "mention" (@name in chat) or "all" (every human message)
COLLAB_AGENT_RESPOND=mention

# Let the model run arbitrary FreeCAD Python. Powerful, but anyone who can
# chat with the agent can then run code on this machine. Keep 0 unless the
# agent runs isolated (its own user/container) and you trust all members.
COLLAB_AGENT_ALLOW_PYTHON=0

# Parametric modelling: every dimension the agent writes must come from this
# spreadsheet (created on first use; columns Parameter | Value | Description,
# values aliased by name). Set to "off" to allow plain numbers.
COLLAB_AGENT_DATASHEET=Datasheet

# Naming: the agent must give everything it creates a descriptive name.
# Default rule: PascalCase parts joined by "_" (BasePlate, BasePlate_Sketch);
# generic names (Box001, Pad, Sketch2) are always rejected while enabled.
COLLAB_AGENT_ENFORCE_NAMES=1
# COLLAB_AGENT_NAME_PATTERN=^[A-Z][A-Za-z0-9]*(_[A-Z0-9][A-Za-z0-9]*)*$

# How often the end-of-request check may send the model back to fix
# unparameterized values or generic names before it replies anyway.
COLLAB_AGENT_POLICY_RETRIES=3

# Verbose log: every chat message seen (and why it was ignored), each model
# call and tool call with timings. Secrets are never logged.
COLLAB_AGENT_DEBUG=0

# Limits
COLLAB_AGENT_MAX_STEPS=16
COLLAB_AGENT_MAX_TURNS_PER_HOUR=60
COLLAB_AGENT_MAX_TOKENS=4096

# Only join these document ids (comma-separated); empty = every invitation
# COLLAB_AGENT_DOCUMENTS=

# Extra standing instructions, e.g. house style
# COLLAB_AGENT_INSTRUCTIONS=Use M3 clearance holes of 3.4 mm. Name features in German.
