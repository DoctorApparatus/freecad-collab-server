# Copy to .env and adjust. Every value shown is the default unless noted.

COLLAB_BIND_ADDR=0.0.0.0:14008
COLLAB_DATABASE_URL=sqlite://data/collab.db
COLLAB_DB_MAX_CONNECTIONS=8

# Enables /v1/admin/* when set (min 32 chars). Generate: openssl rand -hex 32
# COLLAB_ADMIN_TOKEN=

COLLAB_MAX_WS_MESSAGE_BYTES=4194304
COLLAB_MAX_SNAPSHOT_BYTES=536870912
COLLAB_MAX_PROPERTY_VALUE_BYTES=262144
COLLAB_MAX_OPS_PER_SUBMIT=1000
COLLAB_MAX_CATCHUP_OPS=50000
COLLAB_SNAPSHOT_RETENTION=3
COLLAB_CONFLICT_INDEX_CAPACITY=200000
COLLAB_ROOM_CHANNEL_CAPACITY=1024
COLLAB_HEARTBEAT_INTERVAL_SECS=20
COLLAB_CLIENT_TIMEOUT_SECS=60

# Write logs to a file instead of stdout (paths use forward slashes)
# COLLAB_LOG_FILE=

# pretty | json
COLLAB_LOG_FORMAT=pretty
RUST_LOG=info,tower_http=info,sqlx=warn
